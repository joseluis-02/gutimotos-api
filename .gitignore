# .gitignore
# Entorno virtual
.venv/
poetry.lock

# Archivos compilados de Python
*.pyo
*.pyc
__pycache__/

# Configuración específica de la máquina
*.env

# Archivos estáticos y de medios generados

# Archivos de migraciones
**/migrations/*.py[cod]

# Archivos de bases de datos locales
db.sqlite3

# Configuraciones de visual studio code
.vscode
# No subir archivos estśticos
media/*
# Archivo de credenciales
src/secret.json
# Firebase key
firebase-admin-key.json

# Archivos de configuración local
local.py

# Archivos media
src/media/*
src/staticfiles/*

# Archivos de configuración en ubuntu
gunicorn_start.sh
